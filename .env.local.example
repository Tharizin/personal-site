# TEMPLATE ONLY -- this file IS committed. Put real values in `.env.local`
# (gitignored) for local use, and in the Vercel project's Environment
# Variables for the deployed site.
#
# From a GitHub OAuth App: github.com -> Settings -> Developer settings ->
# OAuth Apps -> New OAuth App. Set the Authorization callback URL to
# https://YOUR-DOMAIN/api/callback

# SECRET. No NEXT_PUBLIC_ prefix, so these never reach the browser bundle.
GITHUB_OAUTH_CLIENT_ID=your-client-id
GITHUB_OAUTH_CLIENT_SECRET=your-client-secret

# Optional. Defaults to public_repo, which is enough for a public repository
# and does not grant access to your private ones. Set to `repo` only if this
# repository becomes private.
# GITHUB_OAUTH_SCOPE=public_repo
